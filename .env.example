# LLM Provider Configuration
# Supported providers: "gemini", "groq", or "mock" (auto-selects if no key is provided)
LLM_PROVIDER=gemini

# Google Gemini API Key (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (Free tier available at https://console.groq.com/)
GROQ_API_KEY=

# Host and Port for FastAPI
HOST=127.0.0.1
PORT=8000

